{
  "name": "lk-tronics-music-player",
  "version": "1.3.4",
  "description": "Lk-Tronics Music player system",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore dist --ignore uploads --ignore playlist_cache.json server.js",
    "electron:start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.lk-tronics.musicplayer",
    "productName": "Lk-Tronics Music player",
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "public/**/*",
      "uploads/**/*"
    ]
  },
  "private": true
}